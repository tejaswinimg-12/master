package patternMatching;

public class Mearging {

	public static void main(String[] args) {
		
		//patr1		
		for(int i=1; i<=5; i++)

			//for(int i=5; i>=1; i--)
			{
				for(int j=1; j<=5-i+1; j++)
				{
					System.out.print(" ");
				}
				for(int k=1; k<=i; k++)
				{
					System.out.print("*");
				}
				System.out.println();
			}
		
		// part2
		for(int i=1; i<=5; i++)
		{
			for(int j=1; j<=i; j++)
			{
				System.out.print(" ");
			}
			for(int k=1; k<=5-i+1; k++)
			{
				System.out.print("*");
			}
			System.out.println();
		}
}
}
